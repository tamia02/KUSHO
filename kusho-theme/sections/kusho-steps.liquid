{{ 'kusho-page.css' | asset_url | stylesheet_tag }}

<section class="ksteps kusho-section color-{{ section.settings.color_scheme }} gradient" aria-labelledby="ksteps-title-{{ section.id }}">
  <div class="page-width">
    <header class="ksec-head">
      {%- if section.settings.eyebrow != blank -%}<p class="ksec-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="ksec-title" id="ksteps-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </header>
    <ol class="ksteps__list" role="list">
      {%- for block in section.blocks -%}
        <li class="ksteps__item" {{ block.shopify_attributes }}>
          <span class="ksteps__num" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="ksteps__title">{{ block.settings.title | escape }}</h3>
          <p class="ksteps__text">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Numbered steps",
  "tag": "div",
  "class": "kusho-steps-section",
  "max_blocks": 5,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Numbered steps",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
