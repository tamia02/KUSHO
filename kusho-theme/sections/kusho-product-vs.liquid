{% comment %}
  "Kusho vs a regular pillow": a tick-and-cross comparison. Each row is a feature with one line under it;
  Kusho gets a green tick, the regular product a soft red cross unless the row is marked as something a
  regular one has too. Rows come from blocks (defaults in templates/product.json, written per product family)
  and the right-hand column name follows the product (regular pillow / ordinary cushion / standard travel pillow).
{% endcomment %}
{%- liquid
  assign h = product.handle | downcase
  assign t = product.type | downcase
  assign rival = section.settings.rival_label
  if rival == blank
    if h contains 'travel'
      assign rival = 'A standard travel pillow'
    elsif t contains 'cushion' or h contains 'cushion' or h contains 'seat' or h contains 'lumbar'
      assign rival = 'An ordinary cushion'
    else
      assign rival = 'A regular pillow'
    endif
  endif
  assign family = 'pillow'
  if h contains 'travel'
    assign family = 'travel'
  elsif h contains 'car'
    assign family = 'car'
  elsif t contains 'cushion' or h contains 'cushion' or h contains 'seat' or h contains 'lumbar' or h contains 'tailbone'
    assign family = 'cushion'
  endif
-%}

<section class="kvs kusho-section color-{{ section.settings.color_scheme }} gradient" aria-labelledby="kvs-title-{{ section.id }}">
  <div class="page-width">
    <div class="ksec-head ksec-head--center" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="ksec-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="ksec-title" id="kvs-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="ksec-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>

    <div class="kvs__table" role="table" aria-label="{{ section.settings.heading | escape }}" data-reveal>
      <div class="kvs__row kvs__row--head" role="row">
        <span class="kvs__cell kvs__cell--label" role="columnheader"></span>
        <span class="kvs__cell kvs__cell--kusho" role="columnheader">
          <img class="kvs__mark" src="{{ 'kusho-favicon.png' | asset_url }}" alt="" width="28" height="28">
          <span>Kusho</span>
        </span>
        <span class="kvs__cell kvs__cell--rival" role="columnheader">{{ rival | escape }}</span>
      </div>
      {%- for block in section.blocks -%}
        {%- liquid
          assign show = true
          if block.settings.only != 'all' and block.settings.only != family
            assign show = false
          endif
        -%}
        {%- if show -%}
          <div class="kvs__row" role="row" {{ block.shopify_attributes }}>
            <span class="kvs__cell kvs__cell--label" role="rowheader">
              <span class="kvs__feature">{{ block.settings.label | escape }}</span>
              {%- if block.settings.kusho != blank -%}<span class="kvs__detail">{{ block.settings.kusho | escape }}</span>{%- endif -%}
            </span>
            <span class="kvs__cell kvs__cell--kusho" role="cell">
              <span class="kvs__yes">{% render 'kusho-icon', name: 'check', size: 16 %}<span class="visually-hidden">{{ 'kusho.vs.yes' | t }}</span></span>
            </span>
            <span class="kvs__cell kvs__cell--rival" role="cell">
              {%- if block.settings.rival_has -%}
                <span class="kvs__yes">{% render 'kusho-icon', name: 'check', size: 16 %}<span class="visually-hidden">{{ 'kusho.vs.yes' | t }}</span></span>
              {%- else -%}
                <span class="kvs__no">{% render 'kusho-icon', name: 'x', size: 16 %}<span class="visually-hidden">{{ 'kusho.vs.no' | t }}</span></span>
              {%- endif -%}
            </span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="kvs__note">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product: Kusho vs regular",
  "tag": "div",
  "class": "kusho-product-vs-section",
  "max_blocks": 12,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Why it is different" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What you get that a regular pillow does not" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "rival_label", "label": "Right-hand column name", "info": "Leave blank to match the product: regular pillow, ordinary cushion, standard travel pillow." },
    { "type": "text", "id": "note", "label": "Footnote", "default": "Based on the materials and construction of Kusho products. Individual comfort varies." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Feature", "default": "Memory foam core" },
        { "type": "text", "id": "kusho", "label": "One line about it", "default": "Moulds to you and recovers its shape every night" },
        { "type": "checkbox", "id": "rival_has", "label": "A regular one has this too", "default": false },
        {
          "type": "select",
          "id": "only",
          "label": "Show for",
          "options": [
            { "value": "all", "label": "All products" },
            { "value": "pillow", "label": "Pillows only" },
            { "value": "cushion", "label": "Cushions only" },
            { "value": "car", "label": "Car products only" },
            { "value": "travel", "label": "Travel only" }
          ],
          "default": "all"
        }
      ]
    }
  ],
  "presets": [ { "name": "Product: Kusho vs regular", "blocks": [ { "type": "row" }, { "type": "row" }, { "type": "row" } ] } ]
}
{% endschema %}
