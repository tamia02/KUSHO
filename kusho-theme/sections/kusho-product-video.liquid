{% comment %}
  "See it in use": a full-bleed lifestyle clip on the product page, with a headline and three short facts.
  The clip is chosen automatically from the product (car -> drive, travel -> travel, cushion -> work, else sleep)
  unless a product has its own kusho.video metafield or the section is set to a fixed clip.
  Plays only while on screen (kusho-video.js); the poster photo shows until then and for reduced-motion visitors.
{% endcomment %}
{%- liquid
  assign clip = section.settings.clip
  if clip == 'auto'
    assign h = product.handle | downcase
    assign t = product.type | downcase
    if h contains 'car'
      assign clip = 'drive'
    elsif h contains 'travel'
      assign clip = 'travel'
    elsif t contains 'cushion' or h contains 'lumbar' or h contains 'tailbone' or h contains 'seat'
      assign clip = 'work'
    else
      assign clip = 'sleep'
    endif
  endif
  assign clip_file = 'kusho-video-' | append: clip | append: '.mp4'
  case clip
    when 'drive'
      assign poster = 'kusho-photo-drive-2.webp'
    when 'travel'
      assign poster = 'kusho-photo-travel-2.webp'
    when 'work'
      assign poster = 'kusho-photo-work.webp'
    else
      assign poster = 'kusho-photo-sleep-2.webp'
  endcase
  assign words = section.settings.heading | split: ' '
-%}

<section class="kpvid" aria-labelledby="kpvid-title-{{ section.id }}">
  <div class="kpvid__media kusho-video-host">
    <img class="kpvid__poster" src="{{ poster | asset_url }}" alt="" width="1280" height="720" loading="lazy">
    {%- if product.metafields.kusho.video != blank -%}
      {{
        product.metafields.kusho.video
        | video_tag: image_size: '1600x', autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'none', class: 'kusho-video kpvid__video'
      }}
    {%- else -%}
      <video class="kusho-video kpvid__video" muted loop playsinline preload="none" aria-hidden="true"><source src="{{ clip_file | asset_url }}" type="video/mp4"></video>
    {%- endif -%}
    <span class="kpvid__shade" aria-hidden="true"></span>
  </div>

  <div class="page-width kpvid__content">
    <div class="kpvid__copy" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="ksec-eyebrow ksec-eyebrow--light">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="kpvid__title" id="kpvid-title-{{ section.id }}">
        {%- for word in words -%}
          <span class="kword" style="--w: {{ forloop.index0 }};">{{ word | escape }}</span>
          {%- unless forloop.last %} {% endunless -%}
        {%- endfor -%}
      </h2>
      {%- if section.settings.text != blank -%}<p class="kpvid__text">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="kpvid__facts" role="list">
        {%- for block in section.blocks -%}
          <li data-reveal style="--ri: {{ forloop.index }};" {{ block.shopify_attributes }}>
            <span class="kpvid__num">0{{ forloop.index }}</span>
            <span class="kpvid__fact-title">{{ block.settings.title | escape }}</span>
            <span class="kpvid__fact-text">{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product: see it in use",
  "tag": "div",
  "class": "kusho-product-video-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "select",
      "id": "clip",
      "label": "Video",
      "options": [
        { "value": "auto", "label": "Match the product (recommended)" },
        { "value": "sleep", "label": "Sleeping on the pillow" },
        { "value": "drive", "label": "Resting in the car" },
        { "value": "work", "label": "At the desk" },
        { "value": "travel", "label": "On the plane" }
      ],
      "default": "auto",
      "info": "A product's own kusho.video metafield always wins."
    },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "See it in use" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Made for the way you rest" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Memory foam that takes your shape, a cover that breathes, and support that keeps your neck and back where they should be." }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Memory foam core" },
        { "type": "text", "id": "text", "label": "Text", "default": "Softens with body heat and recovers its shape every morning." }
      ]
    }
  ],
  "presets": [
    { "name": "Product: see it in use", "blocks": [ { "type": "fact" }, { "type": "fact" }, { "type": "fact" } ] }
  ]
}
{% endschema %}
