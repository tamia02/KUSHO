{{ 'kusho-page.css' | asset_url | stylesheet_tag }}
{{ 'kusho-home.css' | asset_url | stylesheet_tag }}

<section class="kblog kusho-section" aria-labelledby="kblog-title-{{ section.id }}">
  <div class="page-width">
    <header class="ksec-head">
      <p class="ksec-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="ksec-title kblog__title" id="kblog-title-{{ section.id }}">{{ section.settings.heading | default: blog.title | escape }}</h1>
      {%- if section.settings.text != blank -%}<p class="ksec-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    </header>

    {%- if blog.all_tags.size > 0 -%}
      <ul class="kblog__tags" role="list" aria-label="{{ 'kusho.blog.topics' | t }}">
        <li><a class="kblog__tag{% unless current_tags %} is-active{% endunless %}" href="{{ blog.url }}"{% unless current_tags %} aria-current="true"{% endunless %}>{{ 'kusho.blog.all' | t }}</a></li>
        {%- for tag in blog.all_tags -%}
          <li><a class="kblog__tag{% if current_tags contains tag %} is-active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handleize }}"{% if current_tags contains tag %} aria-current="true"{% endif %}>{{ tag | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- paginate blog.articles by 9 -%}
      {%- if blog.articles.size == 0 -%}
        <p class="kblog__empty">{{ 'kusho.blog.empty' | t }}</p>
      {%- else -%}
        <ul class="kblog__grid" role="list">
          {%- for article in blog.articles -%}
            <li>{% render 'kusho-article-card', article: article %}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate, anchor: '' %}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "tag": "div",
  "class": "kusho-blog-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "The Kusho journal" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Simple, honest reading about sleep, sitting and travelling comfortably." }
  ],
  "presets": [
    { "name": "Blog" }
  ]
}
{% endschema %}
