{% comment %}
  Full-screen product slide (second screen of the homepage). One product on a clean cream field,
  a row of category chips above it, name and price below. Part of the snap-scrolling opening sequence.
{% endcomment %}
{%- liquid
  assign product = section.settings.product
  assign img = section.settings.image
  if img == blank and section.settings.image_index > 0 and product != blank
    assign idx = section.settings.image_index | minus: 1
    assign img = product.images[idx] | default: product.featured_image
  endif
  assign words = section.settings.heading | split: ' '
-%}

<section class="kslide kslide--product color-{{ section.settings.color_scheme }} gradient" data-slide data-slide-label="{{ section.settings.dot_label | default: 'Product' | escape }}" aria-labelledby="kslide-title-{{ section.id }}">
  <div class="page-width kslide__inner">
    {%- if section.blocks.size > 0 -%}
      <ul class="kslide__chips" role="list" data-slide-item style="--d: 0;">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a class="kslide__chip{% if forloop.first %} is-current{% endif %}" href="{{ block.settings.link | default: '#' }}">{{ block.settings.label | escape }}</a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <h2 class="kslide__title kusho-display" id="kslide-title-{{ section.id }}" data-slide-item style="--d: 1;">
      {%- for word in words -%}
        <span class="kslide__word" style="--i: {{ forloop.index0 }};">{{ word | escape }}</span>
        {%- unless forloop.last %} {% endunless -%}
      {%- endfor -%}
    </h2>

    <a class="kslide__figure" data-slide-item style="--d: 2;" href="{{ product.url | default: '#' }}" aria-label="{{ product.title | escape }}">
      {%- if img != blank -%}
        {{
          img
          | image_url: width: 1400
          | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 60vw, 100vw', alt: product.title, class: 'kslide__img'
        }}
      {%- else -%}
        <img class="kslide__img" src="{{ 'kusho-photo-product-slide.webp' | asset_url }}" alt="{{ product.title | escape }}" width="1400" height="800" loading="lazy">
      {%- endif -%}
    </a>

    {%- if product != blank -%}
      <div class="kslide__meta" data-slide-item style="--d: 3;">
        <a class="kslide__name" href="{{ product.url }}">{{ product.title | escape }}</a>
        <span class="kslide__price">
          {%- if product.compare_at_price > product.price -%}
            <s class="kslide__was">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
          {%- endif -%}
          {{ product.price | money_without_trailing_zeros }}
        </span>
        <a class="button kslide__cta" href="{{ product.url }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Slide: product",
  "tag": "div",
  "class": "kusho-slide-section",
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" },
    { "type": "text", "id": "dot_label", "label": "Dot label", "default": "Product" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Support that follows the curve of your neck" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "range", "id": "image_index", "label": "Which product photo", "min": 0, "max": 8, "step": 1, "default": 0, "info": "0 uses the built-in clean pillow photo. 1 is the first gallery photo. Pick one without text on it." },
    { "type": "image_picker", "id": "image", "label": "Or upload a photo" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop this pillow" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Category chip",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Pillows" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Slide: product", "blocks": [ { "type": "chip" }, { "type": "chip" }, { "type": "chip" } ] }
  ]
}
{% endschema %}
