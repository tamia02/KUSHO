
<section id="kusho-need" class="kbento kusho-section" aria-labelledby="kbento-title-{{ section.id }}">
  <div class="page-width">
    <header class="ksec-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="ksec-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="ksec-title" id="kbento-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="ksec-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    </header>

    <ul class="kbento__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign default_photo = 'kusho-photo-' | append: block.settings.scene | append: '.webp' -%}
        <li class="kbento__tile kbento__tile--{{ forloop.index }}" data-reveal="image" style="--ri: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <a class="kbento__link" href="{{ block.settings.link | default: '#' }}">
            <span class="kbento__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '(min-width: 990px) 34vw, 100vw', alt: '', class: 'kbento__img' }}
              {%- else -%}
                <img class="kbento__img" src="{{ default_photo | asset_url }}" alt="" width="1000" height="800" loading="lazy">
              {%- endif -%}
            </span>
            <span class="kbento__shade" aria-hidden="true"></span>
            <span class="kbento__label">
              <span class="kbento__icon">{% render 'kusho-icon', name: block.settings.icon, size: 22 %}</span>
              <span class="kbento__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.text != blank -%}<span class="kbento__text">{{ block.settings.text | escape }}</span>{%- endif -%}
            </span>
            <span class="kbento__go" aria-hidden="true">{% render 'kusho-icon', name: 'arrow-right', size: 22 %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Shop by need (photos)",
  "tag": "div",
  "class": "kusho-bento-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Shop by need" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What do you need comfort for?" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "select",
          "id": "scene",
          "label": "Built-in photo",
          "options": [
            { "value": "sleep", "label": "Sleeping" },
            { "value": "drive", "label": "Driving" },
            { "value": "work", "label": "Working" },
            { "value": "travel", "label": "Travelling" },
            { "value": "gift", "label": "Gifting" }
          ],
          "default": "sleep"
        },
        { "type": "image_picker", "id": "image", "label": "Your own photo (optional)" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "moon", "label": "Sleep" },
            { "value": "car", "label": "Car" },
            { "value": "back", "label": "Back" },
            { "value": "plane", "label": "Travel" },
            { "value": "gift", "label": "Gift" },
            { "value": "neck", "label": "Neck" }
          ],
          "default": "moon"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Sleep" },
        { "type": "text", "id": "text", "label": "Short line" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by need (photos)",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
